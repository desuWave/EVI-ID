<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
    </Reference>
    <Compile Include="Program.cs" />
    <Compile Include="SemanticExtractionValidator.cs" />
    <Compile Include="SemanticExtractionIntegration.cs" />
    <Compile Include="V7IntegrationRegression.cs" />
    <Compile Include="SymbolBindingPreservationValidator.cs" />
    <Compile Include="CallerInfoSafetyValidator.cs" />
  </ItemGroup>
</Project>
