<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);REFACTOR_CI</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference
      Include="Microsoft.CodeAnalysis.CSharp"
      Version="5.9.0" />

    <Compile Include="Program.cs" />
    <Compile Include="TestSupport.cs" />
    <Compile Include="TestEntry.cs" />

    <Compile Include="../RefactorDirectiveRegressionTests.cs" />
    <Compile Include="../RefactorDirectiveBoundaryTests.cs" />
    <Compile Include="../RefactorDirectiveBridgeTests.cs" />
    <Compile Include="../RefactorSemanticBridgeTests.cs" />
    <Compile Include="../RefactorEngineReferenceTests.cs" />
    <Compile Include="../RefactorLegacyCoverageTests.cs" />

    <Compile Include="../../mdl/*.cs"
             Exclude="../../mdl/OutputNavigator.cs" />
  </ItemGroup>
</Project>
